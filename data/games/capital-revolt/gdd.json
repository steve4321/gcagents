{
  "title": "Capital Revolt",
  "genre": "visual_novel",
  "summary": "A anti-capitalist visual novel where you, a programmer at a 996 tech company, discover evidence of illegal user data theft. Navigate a web of choices affecting your prestige, conscience, financial status, social influence, and technical skill. Choose from four distinct rebellion paths: union leader, hacker, journalist, or idealistic entrepreneur. Face the power of capital and strive for collective awakening.",
  "core_loop": [
    "Read narrative scene",
    "Make a choice from available options",
    "Observe stat changes and story progression",
    "Repeat until route diverges",
    "Reach an ending based on accumulated stats"
  ],
  "mechanics": [
    {
      "name": "Choice_Branching",
      "description": "Presents the player with multiple choices that alter the story path, stat values, and unlock future routes.",
      "inputs": [
        "mouse_click",
        "keyboard_enter"
      ],
      "outputs": [
        "next_scene_id",
        "stat_delta_object"
      ],
      "constraints": [
        "choices_must_be_mutually_exclusive",
        "locked_choices_not_visible"
      ],
      "dependencies": [],
      "implementation_order": 0,
      "complexity": "high"
    },
    {
      "name": "Stat_Tracking",
      "description": "Tracks five core stats (Prestige, Conscience, Money, Social Influence, Tech Ability) ranging 0–100, updated by choices and events.",
      "inputs": [
        "choice_result_event",
        "game_tick"
      ],
      "outputs": [
        "hud_update",
        "route_unlock_flag",
        "ending_condition_check"
      ],
      "constraints": [
        "stats_capped_0_100",
        "stat_decay_per_chapter_2_points_prestige_and_money_only"
      ],
      "dependencies": [
        "Choice_Branching"
      ],
      "implementation_order": 1,
      "complexity": "medium"
    },
    {
      "name": "Route_Unlock",
      "description": "Determines which character route becomes accessible based on stat thresholds and previous major choices.",
      "inputs": [
        "stat_values",
        "completed_chapter_id"
      ],
      "outputs": [
        "available_route_list",
        "route_locked_dialogue"
      ],
      "constraints": [
        "only_one_route_active_per_playthrough",
        "minimum_stat_requirements_for_each_route"
      ],
      "dependencies": [
        "Stat_Tracking"
      ],
      "implementation_order": 2,
      "complexity": "high"
    },
    {
      "name": "Ending_Determination",
      "description": "Evaluates final stats and chosen route at the end of the game to assign one of multiple endings.",
      "inputs": [
        "route_id",
        "final_stat_values"
      ],
      "outputs": [
        "ending_id",
        "cg_unlock_flag",
        "epilogue_scene_id"
      ],
      "constraints": [
        "exactly_one_ending_assigned",
        "conditions_must_be_unique"
      ],
      "dependencies": [
        "Route_Unlock",
        "Stat_Tracking"
      ],
      "implementation_order": 3,
      "complexity": "medium"
    },
    {
      "name": "Scene_Management_And_Save",
      "description": "Manages scene transitions, dialogue history, and save/load functionality across multiple slots.",
      "inputs": [
        "scene_complete_event",
        "user_save_input",
        "user_load_input"
      ],
      "outputs": [
        "next_scene_data",
        "save_state_persisted",
        "loaded_state"
      ],
      "constraints": [
        "max_save_slots_3",
        "autosave_on_route_divergence"
      ],
      "dependencies": [
        "Choice_Branching"
      ],
      "implementation_order": 4,
      "complexity": "medium"
    }
  ],
  "progression": "Player starts with a common prologue chapter. After meeting key NPCs, a critical choice determines which route to follow. Each route consists of three chapters with escalating stakes. Final chapter leads to an ending based on accumulated stats.",
  "win_condition": "Reach any of the 8 endings by completing the story. Full completion (all endings unlocked) is the long-term goal.",
  "monetization": {
    "model": "free_to_play",
    "ad_placement": [
      "interstitial_between_chapters",
      "rewarded_video_for_extra_save_slot"
    ],
    "iap_tiers": [
      {
        "name": "supporter_pack",
        "price_usd": 1.99,
        "contents": "Unlock concept art gallery and developer commentary"
      },
      {
        "name": "collector_edition",
        "price_usd": 4.99,
        "contents": "All endings unlocked, digital soundtrack, and exclusive wallpapers"
      }
    ],
    "retention_hooks": [
      "achievement_system",
      "ending_collection_gallery"
    ],
    "engagement_mechanics": [
      "social_sharing_of_ending_results",
      "stat_display_comparison_with_friends"
    ]
  },
  "art_style": {
    "theme": "semi-realistic anime with desaturated tones, red/black accents",
    "color_palette": [
      "#1a1a1a",
      "#c0392b",
      "#ecf0f1",
      "#2c3e50"
    ],
    "reference": "Visual style inspired by Doki Doki Literature Club character art but with a grungy, corporate cyberpunk texture."
  },
