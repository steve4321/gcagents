{
  "title": "Capital Revolt",
  "genre": "visual-novel",
  "summary": "In 资本崩塌 (Capital Revolt), you are a low-level programmer at a 996 tech giant who uncovers evidence of illegal user data theft. Navigate a web of corruption, labor exploitation, and moral compromise as you choose between four distinct paths: union leader, hacker, journalist, or idealist entrepreneur. Your decisions affect five core stats – morality, economy, social influence, mental health, and technical ability – leading to over eight unique endings ranging from becoming the new capitalist to sparking a genuine collective awakening.",
  "core_loop": [
    "Read dialogue and narrative exposition",
    "Make a choice from 2-4 options",
    "Observe stat changes and branching consequences",
    "Progress through common and route-specific chapters",
    "Reach an ending based on accumulated stats and flags"
  ],
  "mechanics": [
    {
      "name": "Choice_Resolution",
      "description": "Player selects a dialogue option; the choice modifies stats, unlocks routes, and advances the narrative.",
      "inputs": [
        "mouse_click",
        "keyboard_enter"
      ],
      "outputs": [
        "updated_stat_values",
        "dialogue_transition"
      ],
      "constraints": [
        "each_choice_has_up_to_4_options",
        "no_undo_after_selection"
      ],
      "dependencies": [],
      "implementation_order": 0,
      "complexity": "medium"
    },
    {
      "name": "Stat_Branching",
      "description": "Stats are tracked across the game; threshold checks at key scenes unlock or lock certain paths and endings.",
      "inputs": [
        "stat_values",
        "game_flags"
      ],
      "outputs": [
        "unlocked_routes",
        "ending_eligibility"
      ],
      "constraints": [
        "stats_range_0_100",
        "decay_over_chapters"
      ],
      "dependencies": [
        "Choice_Resolution"
      ],
      "implementation_order": 1,
      "complexity": "high"
    },
    {
      "name": "Route_Selection",
      "description": "Players commit to a character route after the common chapters; each route has its own story arc and ending conditions.",
      "inputs": [
        "stat_threshold_checks",
        "player_choice"
      ],
      "outputs": [
        "route_locked",
        "route_specific_dialogue"
      ],
      "constraints": [
        "can_only_commit_once",
        "route_unlocks_persist"
      ],
      "dependencies": [
        "Stat_Branching",
        "Choice_Resolution"
      ],
      "implementation_order": 2,
      "complexity": "medium"
    },
    {
      "name": "Relationship_Tracking",
      "description": "Each major NPC has an affinity value that influences available dialogue and endings.",
      "inputs": [
        "player_choices",
        "npc_dialogue_flags"
      ],
      "outputs": [
        "affinity_update",
        "new_scene_unlock"
      ],
      "constraints": [
        "affinity_range_-50_100",
        "cumulative_over_routes"
      ],
      "dependencies": [
        "Choice_Resolution"
      ],
      "implementation_order": 3,
      "complexity": "medium"
    },
    {
      "name": "Ending_Calculation",
      "description": "At the end of each route, final stats and flags are evaluated to determine which of the 8+ endings is triggered.",
      "inputs": [
        "final_stat_values",
        "route_played",
        "achieved_flags"
      ],
      "outputs": [
        "ending_scene_key",
        "epilogue"
      ],
      "constraints": [
        "exactly_one_ending_per_playthrough",
        "ends_game"
      ],
      "dependencies": [
        "Stat_Branching",
        "Route_Selection",
        "Relationship_Tracking"
      ],
      "implementation_order": 4,
      "complexity": "high"
    }
  ],
  "progression": "The game is divided into a common route (6 chapters) where the player establishes relationships and core stats, followed by a route selection. Each character route has 4 chapters, culminating in a final evaluation that triggers one of the endings. New game+ carries over minor bonuses (e.g., starting stat boosts).",
  "win_condition": "The game is complete when any ending is reached. Replayability comes from discovering all endings and routes. The 'true' ending (collective awakening) requires specific stat thresholds and flags across all routes.",
